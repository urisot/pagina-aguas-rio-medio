---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const medidas = [
  { icon: 'science', title: 'Cloración y desinfección', text: 'El agua se clora de forma continua en el proceso de extracción, bombeo y distribución para mantener cloro residual libre.' },
  { icon: 'biotech', title: 'Monitoreo de calidad', text: 'Se vigilan parámetros fisicoquímicos y bacteriológicos conforme a la norma NOM-127-SSA1.' },
  { icon: 'water_heater', title: 'Tanque elevado', text: 'Reserva de 1.4 millones de litros que estabiliza la presión y asegura el suministro.' },
  { icon: 'filter_alt', title: 'Planta de tratamiento', text: 'Tratamiento biológico y desinfección de aguas residuales conforme a la norma NOM-001.' },
  { icon: 'build', title: 'Mantenimiento preventivo', text: 'Revisión de la red, drenes y equipos cada 6 meses.' },
  { icon: 'home_repair_service', title: 'Cuidados en tu hogar', text: 'Limpia tu cisterna y tinaco cada 6 meses y revisa que estén bien tapados.' },
];
---

<BaseLayout title="Medidas sanitarias y calidad del agua" description="Protocolos de purificación, monitoreo de calidad del agua potable y tratamiento de aguas residuales en Lomas de Río Medio 4 y Bosques de Río Medio.">
  <PageHero eyebrow="Calidad del agua" title="Medidas sanitarias y calidad" lead="Protocolos de purificación, monitoreo y mantenimiento integral de nuestras instalaciones." icon="health_and_safety" />
  <section class="container-site py-16">
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {medidas.map((m) => (
        <li class="card reveal">
          <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#eaf7e8] text-[#2e7d32]"><span class="icon !text-[2.8rem]" aria-hidden="true">{m.icon}</span></span>
          <h2 class="font-display text-xl font-bold">{m.title}</h2>
          <p class="mt-2 text-on-surface-variant">{m.text}</p>
        </li>
      ))}
    </ul>
    <p class="mt-10 rounded-2xl bg-surface-container-low p-6 text-on-surface-variant">
      <strong class="text-on-surface">Importante:</strong> si notas cambios de color, olor o sabor en tu agua, repórtalo de inmediato por WhatsApp o en nuestras oficinas.
    </p>
  </section>
</BaseLayout>
