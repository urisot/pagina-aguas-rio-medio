---
import { site, nav } from '../data/site.js';

const path = Astro.url.pathname;
const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="no-print sticky top-0 z-50 border-b border-slate-100 bg-white/90 backdrop-blur-md">
  <div class="container-site flex h-20 items-center justify-between gap-4">
    <a href="/" class="flex-shrink-0" aria-label="Aguas de Río Medio, inicio">
      <img src="/aguas_logo.png" alt="Aguas de Río Medio, servicios de agua potable y saneamiento" width="299" height="59" class="h-[4.2rem] w-auto" />
    </a>

    <nav aria-label="Principal" class="hidden items-center lg:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap rounded-lg px-2.5 py-2 font-display text-[1.3rem] font-semibold transition-colors hover:bg-surface-container hover:text-primary',
              isActive(item.href) ? 'bg-surface-container text-primary' : 'text-on-surface',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a href={site.phoneHref} class="hidden whitespace-nowrap items-center gap-2 rounded-full bg-surface-container-low px-3 py-2 font-display text-xs font-bold text-on-surface-variant transition hover:bg-surface-container hover:text-on-surface 2xl:flex">
        <span class="icon !text-[1.8rem] text-primary-brand" aria-hidden="true">call</span>{site.phone}
      </a>
      <a href="/pago-en-linea/" class="btn btn-eco !h-[4.2rem] whitespace-nowrap !rounded-full !px-4 shadow-sm sm:!px-5">
        <span class="icon !text-[1.8rem]" aria-hidden="true">credit_card</span>
        <span class="hidden sm:inline">Pagar en línea</span><span class="sm:hidden">Pagar</span>
      </a>
      <details class="group relative lg:hidden">
        <summary
          class="flex h-[4.2rem] w-[4.2rem] cursor-pointer list-none items-center justify-center rounded-lg text-on-surface transition hover:bg-surface-container [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menú"
        >
          <span class="icon group-open:hidden" aria-hidden="true">menu</span>
          <span class="icon hidden group-open:inline-block" aria-hidden="true">close</span>
        </summary>
        <nav
          aria-label="Menú móvil"
          class="fixed inset-x-0 top-[8.4rem] mx-4 space-y-1 rounded-2xl border border-slate-100 bg-white p-4 shadow-modal"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block rounded-lg px-4 py-3 font-display text-base font-semibold hover:bg-surface-container hover:text-primary',
                  isActive(item.href) ? 'bg-surface-container text-primary' : 'text-on-surface',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <a href={site.phoneHref} class="mt-2 flex items-center gap-2 border-t border-slate-100 px-4 pt-4 font-semibold text-primary">
            <span class="icon !text-[2rem]" aria-hidden="true">call</span> {site.phone}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
