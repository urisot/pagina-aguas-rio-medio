---
const { href, title, summary, date, category } = Astro.props;
const fecha = date.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });
---

<article class="card card-hover group relative flex h-full flex-col">
  <p class="mb-3 flex items-center gap-2">
    <span class="badge badge-info">{category}</span>
    <time datetime={date.toISOString()} class="text-xs font-semibold text-on-surface-variant">{fecha}</time>
  </p>
  <h3 class="font-display text-xl font-bold leading-snug">
    <a href={href} class="after:absolute after:inset-0 hover:text-primary-brand relative">{title}</a>
  </h3>
  <p class="mt-3 flex-grow text-on-surface-variant">{summary}</p>
  <p class="mt-5 flex items-center gap-1 font-display text-sm font-bold text-primary-brand">
    Leer más <span class="icon !text-[1.8rem] transition-transform group-hover:translate-x-1" aria-hidden="true">arrow_forward</span>
  </p>
</article>
