---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site.js';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { titulo, resumen, fecha, categoria } = entry.data;
const fechaTexto = fecha.toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: titulo,
  description: resumen,
  datePublished: fecha.toISOString(),
  publisher: { '@type': 'Organization', name: site.name, logo: { '@type': 'ImageObject', url: `${site.url}/logo.svg` } },
};
---

<BaseLayout title={titulo} description={resumen} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="container-site py-14">
    <nav aria-label="Migas de pan" class="mb-6 text-sm font-semibold text-on-surface-variant">
      <a href="/noticias/" class="text-primary-brand hover:underline">Noticias</a> <span aria-hidden="true">/</span> {categoria}
    </nav>
    <header class="max-w-3xl space-y-4">
      <span class="badge badge-info">{categoria}</span>
      <h1 class="font-display text-4xl font-extrabold sm:text-5xl">{titulo}</h1>
      <p class="text-lg text-on-surface-variant">{resumen}</p>
      <time datetime={fecha.toISOString()} class="block text-sm font-semibold text-on-surface-variant">{fechaTexto}</time>
    </header>
    <div class="prose-site mt-10"><Content /></div>
    <p class="mt-12"><a href="/noticias/" class="btn btn-ghost">← Volver a noticias</a></p>
  </article>
</BaseLayout>
