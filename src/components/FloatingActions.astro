---
import { site } from '../data/site.js';
---

<div class="floating-actions no-print fixed bottom-5 right-5 z-40 flex flex-col items-end gap-3">
  <a
    href={site.emergencyHref}
    class="flex h-[5.2rem] items-center gap-2 rounded-full bg-error px-5 font-display text-sm font-bold text-white shadow-modal transition hover:scale-105"
    aria-label={`Llamar al teléfono de emergencias ${site.emergencyPhone}`}
  >
    <span class="icon" aria-hidden="true">emergency</span>
    <span class="hidden sm:inline">Emergencias</span>
  </a>
  <a
    href={site.whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="flex h-[5.6rem] items-center gap-2 rounded-full bg-[#1f8f4e] px-5 font-display text-sm font-bold text-white shadow-modal transition hover:scale-105"
    aria-label="Escribir por WhatsApp (se abre en una pestaña nueva)"
  >
    <span class="icon icon-fill" aria-hidden="true">chat</span>
    <span class="hidden sm:inline">WhatsApp</span>
  </a>
</div>
